      "policy_substitution_assessment": "str",
      "high_risk_assessment": "str | null",
      "architecture_sync_assessment": "str | null",
      "generated_at": "iso8601"
    }
  },
  "ai_change_acceptance_evidence": {
    "description": "Machine-readable reviewer evidence status for one imported acceptance requirement.",
    "fields": {
      "requirement_id": "str",
      "status": "enum:pass|fail|missing",
      "reviewed_artifact_paths": "list[str]",
      "comparator_basis": "str | null",
      "notes": "str"
    }
  },
