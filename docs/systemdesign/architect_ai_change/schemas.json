{
  "ai_change_run_manifest": {
    "description": "Persistent control-plane state for one git/local-review ai-change run.",
    "fields": {
      "run_id": "str",
      "task_summary": "str",
      "status": "enum:active",
      "workflow_mode": "enum:git_local_review",
      "execution_mode": "enum:manual|autopilot",
      "review_transport": "enum:local_branch_diff",
      "local_governance_role": "enum:primary_review_and_checks",
      "git_repo_present": "bool",
      "base_branch": "str",
      "head_branch": "str",
      "review_title": "str",
      "acceptance_sources": "list[str]",
      "acceptance_mode": "enum:scoped|strict",
      "acceptance_scope_file": "str | null",
      "implementer_id": "str",
      "implementer_session_id": "str",
      "review_state": "enum:deferred_until_ready|ready_for_review",
      "last_checkpoint_commit": "str | null",
      "last_checkpoint_at": "iso8601 | null",
      "autopilot_next_action": "str | null",
      "latest_review_result": "str | null",
      "latest_review_next_action": "str | null",
      "latest_review_findings_count": "int | null",
      "latest_review_blocking_findings_count": "int | null",
      "latest_review_basis_head_commit": "str | null",
      "created_at": "iso8601",
      "updated_at": "iso8601"
    }
  },
  "ai_change_acceptance_requirement": {
    "description": "Imported or scoped acceptance obligation derived from an explicit acceptance-source doc or scope file.",
    "fields": {
      "requirement_id": "str",
      "acceptance_source": "str",
      "source_section": "str",
      "requirement_kind": "enum:acceptance_criteria|exit_criteria|validation|evaluation|comparison|acceptance_evidence",
      "evidence_type": "enum:assertion|artifact|command|comparator|review|run",
      "requirement_text": "str",
      "command_text": "str | null",
      "required_artifact_paths": "list[str]",
      "comparator_basis": "str | null",
      "approval_blocking": "bool",
      "context_only": "bool",
      "scope_source": "str | null",
      "auto_evidence_key": "str | null"
    }
  },
  "ai_change_independent_review": {
    "description": "AI-generated independent code-review artifact for one reviewed branch state.",
    "fields": {
      "run_id": "str",
      "reviewer_type": "enum:ai",
      "provider": "str",
      "model": "str",
      "prompt_version": "str",
      "review_basis_head_commit": "str",
      "paths": "list[str]",
      "implementer_id": "str",
      "implementer_session_id": "str",
      "reviewer_id": "str",
      "reviewer_session_id": "str",
      "review_result": "enum:pending_local_review|approved|approved_with_advisories|changes_requested",
      "findings_count": "int",
      "blocking_findings_count": "int",
      "summary": "str",
      "findings": "list[obj]",
